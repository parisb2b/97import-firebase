rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lecture publique — médias produits accessibles sans auth
    match /{allPaths=**} { allow read: if true; }

    // V87 — Clients peuvent uploader des photos pour produits sur mesure
    match /custom_products/{file} { allow write: if request.auth != null; }

    // ANO-004 — Écriture restreinte aux admins (firestore.get cross-service)
    match /{allPaths=**} {
      allow write: if request.auth != null &&
                   request.auth.token.email != null &&
                   firestore.get(/databases/(default)/documents/users/$(request.auth.token.email)).data.role == 'admin';
    }
  }
}
